load("@platform//platform/platform.pinc", "platform")
load("//components/defaults.pinc", "CLUSTERS")
load("//components/demo.pinc", "CONFIG_FILE_TYPES")
load("//components/frontend_proxy.pinc", "FrontendProxyComponent")

# The OpenTelemetry demo (https://github.com/open-telemetry/opentelemetry-demo), with a
# Prometheus and Grafana stack, as platform components. One component per file under
# components/; start with components/cart.pinc for the shape they all share, and
# components/demo.pinc for the hooks they are written with.
#
# The inventory is one component. A component brings its dependencies with it, so naming
# the root of the graph — the storefront proxy — is naming all of it; the failure domain
# set here is inherited by every one of them. It is rendered once per cluster in CLUSTERS,
# each copy under its own domain: outputs/otel_demo/<domain>/.
#
# CONFIG_FILE_TYPES tells GetConfigs about the config file messages the components render
# beside their Terraform (see WithConfigFile), so it writes those too.
def main():
    configs = {}
    for domain in CLUSTERS:
        configs.update(platform.GetConfigs(
            FrontendProxyComponent(platform.WithFailureDomain(domain)).msg,
            CONFIG_FILE_TYPES,
        ))
    return configs
