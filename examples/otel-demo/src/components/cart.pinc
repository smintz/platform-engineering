load("@kubernetes//kubernetes.pinc", "WithMemoryLimit")
load("@platform//platform/platform.pinc", "platform")
load("//components/defaults.pinc", "Defaults")
load("//components/demo.pinc", "DemoImage", "WithDemoWorkload", "WithDependantEnv", "WithEnv")
load("//components/flagd.pinc", "FlagdComponent")
load("//components/objectives.pinc", "WithRequestObjectives")
load("//components/otel_collector.pinc", "Collector")
load("//components/valkey_cart.pinc", "ValkeyCartComponent")

# The shopping cart (.NET), kept in valkey-cart.
#
# The shape every component in this directory follows, one hook per concern:
#   what it is            WithDescription, WithLabels
#   how it runs           WithDemoWorkload(image, port, ...hooks shaping the workload)
#   what it needs         WithDeps — each dependency hands over its own address
#   what it offers        WithDependantEnv — the address this one hands to its dependants
#   what it promises      WithRequestObjectives
#   what everything gets  Defaults(*hooks), last
def CartComponent(*hooks):
    return platform.Component(
        "cart",
        platform.WithDescription("Shopping cart, kept in Valkey"),
        platform.WithLabels(criticality = "high"),
        WithDemoWorkload(
            DemoImage("cart"),
            8080,
            WithEnv(CART_PORT = "8080", ASPNETCORE_URLS = "http://*:8080"),
            WithMemoryLimit("160Mi"),
        ),
        platform.WithDeps(Collector("grpc"), FlagdComponent, ValkeyCartComponent),
        WithDependantEnv(CART_ADDR = "cart:8080"),
        WithRequestObjectives(200),
        Defaults(*hooks),
    )
