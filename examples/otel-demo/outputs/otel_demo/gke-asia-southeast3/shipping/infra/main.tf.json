{
  "resource": {
    "kubernetes_deployment_v1": {
      "shipping": {
        "metadata": {
          "labels": {
            "app": "shipping"
          },
          "name": "shipping"
        },
        "spec": {
          "selector": {
            "match_labels": {
              "app": "shipping"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "shipping"
              }
            },
            "spec": {
              "container": [
                {
                  "image": "ghcr.io/open-telemetry/demo:3.0.0-shipping",
                  "name": "shipping",
                  "env": [
                    {
                      "name": "OTEL_SERVICE_NAME",
                      "value": "shipping"
                    },
                    {
                      "name": "OTEL_RESOURCE_ATTRIBUTES",
                      "value": "service.version=3.0.0"
                    },
                    {
                      "name": "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE",
                      "value": "cumulative"
                    },
                    {
                      "name": "SHIPPING_PORT",
                      "value": "8080"
                    },
                    {
                      "name": "IPV6_ENABLED",
                      "value": "false"
                    },
                    {
                      "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
                      "value": "http://otel-collector:4318"
                    },
                    {
                      "name": "OTEL_EXPORTER_OTLP_PROTOCOL",
                      "value": "http/protobuf"
                    },
                    {
                      "name": "OTEL_COLLECTOR_HOST",
                      "value": "otel-collector"
                    },
                    {
                      "name": "OTEL_COLLECTOR_PORT_GRPC",
                      "value": "4317"
                    },
                    {
                      "name": "OTEL_COLLECTOR_PORT_HTTP",
                      "value": "4318"
                    },
                    {
                      "name": "FLAGD_HOST",
                      "value": "flagd"
                    },
                    {
                      "name": "FLAGD_PORT",
                      "value": "8013"
                    },
                    {
                      "name": "QUOTE_ADDR",
                      "value": "http://quote:8080"
                    }
                  ],
                  "port": [
                    {
                      "container_port": "8080"
                    }
                  ],
                  "resources": {
                    "limits": {
                      "memory": "20Mi"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "kubernetes_service_v1": {
      "shipping": {
        "metadata": {
          "labels": {
            "app": "shipping"
          },
          "name": "shipping"
        },
        "spec": {
          "selector": {
            "app": "shipping"
          },
          "port": [
            {
              "port": "8080",
              "target_port": "8080"
            }
          ]
        }
      }
    }
  },
  "data": {
    "terraform_remote_state": {
      "cluster": {
        "backend": "gcs",
        "config": {
              "bucket": "home-run-it-tfstate",
              "prefix": "gke-asia-southeast3/cluster"
            }
      }
    },
    "google_client_config": {
      "gke_auth": {
        
      }
    }
  },
  "provider": {
    "google": [
      {
        "project": "home-run-it",
        "region": "asia-southeast3"
      }
    ],
    "kubernetes": [
      {
        "cluster_ca_certificate": "${base64decode(data.terraform_remote_state.cluster.outputs.ca_certificate)}",
        "host": "https://${data.terraform_remote_state.cluster.outputs.endpoint}",
        "token": "${data.google_client_config.gke_auth.access_token}"
      }
    ]
  },
  "terraform": {
    "required_providers": {
      "google": {
        "source": "registry.terraform.io/hashicorp/google",
        "version": "8.3.0"
      },
      "kubernetes": {
        "source": "registry.terraform.io/hashicorp/kubernetes",
        "version": "3.2.1"
      }
    },
    "backend": {
      "gcs": {
        "bucket": "home-run-it-tfstate",
        "prefix": "gke-asia-southeast3/shipping"
      }
    }
  }
}