{
  "resource": {
    "kubernetes_config_map_v1": {
      "astronomy-db": {
        "data": {
          "init.sql": "${file(\"${path.module}/../../../../../files/init.sql\")}"
        },
        "metadata": {
          "name": "astronomy-db"
        }
      }
    },
    "kubernetes_deployment_v1": {
      "astronomy-db": {
        "metadata": {
          "labels": {
            "app": "astronomy-db"
          },
          "name": "astronomy-db"
        },
        "spec": {
          "selector": {
            "match_labels": {
              "app": "astronomy-db"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "astronomy-db"
              }
            },
            "spec": {
              "container": [
                {
                  "image": "postgres:18.4",
                  "name": "astronomy-db",
                  "env": [
                    {
                      "name": "OTEL_SERVICE_NAME",
                      "value": "astronomy-db"
                    },
                    {
                      "name": "OTEL_RESOURCE_ATTRIBUTES",
                      "value": "service.version=3.0.0"
                    },
                    {
                      "name": "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE",
                      "value": "cumulative"
                    },
                    {
                      "name": "POSTGRES_PASSWORD",
                      "value": "changeit"
                    }
                  ],
                  "port": [
                    {
                      "container_port": "5432"
                    }
                  ],
                  "resources": {
                    "limits": {
                      "memory": "100Mi"
                    }
                  },
                  "volume_mount": [
                    {
                      "mount_path": "/docker-entrypoint-initdb.d",
                      "name": "astronomy-db",
                      "read_only": true,
                      "sub_path": ""
                    }
                  ]
                }
              ],
              "volume": [
                {
                  "name": "astronomy-db",
                  "config_map": {
                    "name": "${kubernetes_config_map_v1.astronomy-db.metadata[0].name}"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "kubernetes_service_v1": {
      "astronomy-db": {
        "metadata": {
          "labels": {
            "app": "astronomy-db"
          },
          "name": "astronomy-db"
        },
        "spec": {
          "selector": {
            "app": "astronomy-db"
          },
          "port": [
            {
              "port": "5432",
              "target_port": "5432"
            }
          ]
        }
      }
    }
  },
  "data": {
    "terraform_remote_state": {
      "cluster": {
        "backend": "gcs",
        "config": {
              "bucket": "home-run-it-tfstate",
              "prefix": "gke-asia-southeast3/cluster"
            }
      }
    },
    "google_client_config": {
      "gke_auth": {
        
      }
    }
  },
  "provider": {
    "google": [
      {
        "project": "home-run-it",
        "region": "asia-southeast3"
      }
    ],
    "kubernetes": [
      {
        "cluster_ca_certificate": "${base64decode(data.terraform_remote_state.cluster.outputs.ca_certificate)}",
        "host": "https://${data.terraform_remote_state.cluster.outputs.endpoint}",
        "token": "${data.google_client_config.gke_auth.access_token}"
      }
    ]
  },
  "terraform": {
    "required_providers": {
      "google": {
        "source": "registry.terraform.io/hashicorp/google",
        "version": "8.3.0"
      },
      "kubernetes": {
        "source": "registry.terraform.io/hashicorp/kubernetes",
        "version": "3.2.1"
      }
    },
    "backend": {
      "gcs": {
        "bucket": "home-run-it-tfstate",
        "prefix": "gke-asia-southeast3/astronomy-db"
      }
    }
  }
}