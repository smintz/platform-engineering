            "uses": "actions/github-script@v7",
            "env": {
              "NEEDS": "${{ toJSON(needs) }}",
              "PLANS": "[{\"job\":\"plan_gke_asia_southeast3_ad_infra\",\"label\":\"gke-asia-southeast3/ad/infra\",\"slug\":\"gke_asia_southeast3_ad_infra\"},{\"job\":\"plan_gke_asia_southeast3_astronomy_db_infra\",\"label\":\"gke-asia-southeast3/astronomy-db/infra\",\"slug\":\"gke_asia_southeast3_astronomy_db_infra\"},{\"job\":\"plan_gke_asia_southeast3_cart_infra\",\"label\":\"gke-asia-southeast3/cart/infra\",\"slug\":\"gke_asia_southeast3_cart_infra\"},{\"job\":\"plan_gke_asia_southeast3_checkout_infra\",\"label\":\"gke-asia-southeast3/checkout/infra\",\"slug\":\"gke_asia_southeast3_checkout_infra\"},{\"job\":\"plan_gke_asia_southeast3_cluster_infra\",\"label\":\"gke-asia-southeast3/cluster/infra\",\"slug\":\"gke_asia_southeast3_cluster_infra\"},{\"job\":\"plan_gke_asia_southeast3_currency_infra\",\"label\":\"gke-asia-southeast3/currency/infra\",\"slug\":\"gke_asia_southeast3_currency_infra\"},{\"job\":\"plan_gke_asia_southeast3_email_infra\",\"label\":\"gke-asia-southeast3/email/infra\",\"slug\":\"gke_asia_southeast3_email_infra\"},{\"job\":\"plan_gke_asia_southeast3_flagd_ui_infra\",\"label\":\"gke-asia-southeast3/flagd-ui/infra\",\"slug\":\"gke_asia_southeast3_flagd_ui_infra\"},{\"job\":\"plan_gke_asia_southeast3_flagd_infra\",\"label\":\"gke-asia-southeast3/flagd/infra\",\"slug\":\"gke_asia_southeast3_flagd_infra\"},{\"job\":\"plan_gke_asia_southeast3_frontend_proxy_infra\",\"label\":\"gke-asia-southeast3/frontend-proxy/infra\",\"slug\":\"gke_asia_southeast3_frontend_proxy_infra\"},{\"job\":\"plan_gke_asia_southeast3_frontend_infra\",\"label\":\"gke-asia-southeast3/frontend/infra\",\"slug\":\"gke_asia_southeast3_frontend_infra\"},{\"job\":\"plan_gke_asia_southeast3_grafana_infra\",\"label\":\"gke-asia-southeast3/grafana/infra\",\"slug\":\"gke_asia_southeast3_grafana_infra\"},{\"job\":\"plan_gke_asia_southeast3_image_provider_infra\",\"label\":\"gke-asia-southeast3/image-provider/infra\",\"slug\":\"gke_asia_southeast3_image_provider_infra\"},{\"job\":\"plan_gke_asia_southeast3_jaeger_infra\",\"label\":\"gke-asia-southeast3/jaeger/infra\",\"slug\":\"gke_asia_southeast3_jaeger_infra\"},{\"job\":\"plan_gke_asia_southeast3_load_generator_infra\",\"label\":\"gke-asia-southeast3/load-generator/infra\",\"slug\":\"gke_asia_southeast3_load_generator_infra\"},{\"job\":\"plan_gke_asia_southeast3_network_infra\",\"label\":\"gke-asia-southeast3/network/infra\",\"slug\":\"gke_asia_southeast3_network_infra\"},{\"job\":\"plan_gke_asia_southeast3_otel_collector_infra\",\"label\":\"gke-asia-southeast3/otel-collector/infra\",\"slug\":\"gke_asia_southeast3_otel_collector_infra\"},{\"job\":\"plan_gke_asia_southeast3_payment_infra\",\"label\":\"gke-asia-southeast3/payment/infra\",\"slug\":\"gke_asia_southeast3_payment_infra\"},{\"job\":\"plan_gke_asia_southeast3_product_catalog_infra\",\"label\":\"gke-asia-southeast3/product-catalog/infra\",\"slug\":\"gke_asia_southeast3_product_catalog_infra\"},{\"job\":\"plan_gke_asia_southeast3_prometheus_infra\",\"label\":\"gke-asia-southeast3/prometheus/infra\",\"slug\":\"gke_asia_southeast3_prometheus_infra\"},{\"job\":\"plan_gke_asia_southeast3_quote_infra\",\"label\":\"gke-asia-southeast3/quote/infra\",\"slug\":\"gke_asia_southeast3_quote_infra\"},{\"job\":\"plan_gke_asia_southeast3_recommendation_infra\",\"label\":\"gke-asia-southeast3/recommendation/infra\",\"slug\":\"gke_asia_southeast3_recommendation_infra\"},{\"job\":\"plan_gke_asia_southeast3_shipping_infra\",\"label\":\"gke-asia-southeast3/shipping/infra\",\"slug\":\"gke_asia_southeast3_shipping_infra\"},{\"job\":\"plan_gke_asia_southeast3_telemetry_docs_infra\",\"label\":\"gke-asia-southeast3/telemetry-docs/infra\",\"slug\":\"gke_asia_southeast3_telemetry_docs_infra\"},{\"job\":\"plan_gke_asia_southeast3_valkey_cart_infra\",\"label\":\"gke-asia-southeast3/valkey-cart/infra\",\"slug\":\"gke_asia_southeast3_valkey_cart_infra\"}]"
            },
            "with": {
              "script": "const fs = require('fs');\nconst tag = '<!-- tf-plan -->';\nconst plans = JSON.parse(process.env.PLANS);\nconst needs = JSON.parse(process.env.NEEDS);\nconst runId = process.env.GITHUB_RUN_ID;\n\n// GitHub rejects a comment over 65536 characters, and a rejected comment says nothing at\n// all about any state. Everything below is spent staying under that.\nconst BUDGET = 60000;\n\nconst rows = [];\nconst changed = [];\nfor (const p of plans) {\n  const job = needs[p.job] || {};\n  const result = job.result || 'skipped';\n  const changes = (job.outputs || {}).changes;\n  rows.push(`| \\`${p.label}\\` | ${result === 'success' ? (changes === 'true' ? 'changes' : 'no changes') : result} |`);\n  if (result !== 'success' || changes !== 'true') continue;\n  try {\n    changed.push({ label: p.label, text: fs.readFileSync(`plans/tfplan-${p.slug}-${runId}/plan.txt`, 'utf8') });\n  } catch (e) {\n    core.warning(`no plan artifact for ${p.label}`);\n  }\n}\n\nconst header = `${tag}\n### Terraform plan\n\n| state | plan |\n| --- | --- |\n${rows.join('\\n')}\n`;\n\n// Only the states that changed are worth showing, and they share what is left of the\n// budget equally, so one enormous plan cannot crowd every other state out of the comment.\nconst share = changed.length ? Math.floor((BUDGET - header.length) / changed.length) - 200 : 0;\nconst details = changed.map(c => {\n  const text = c.text.length > share ? c.text.slice(0, Math.max(share, 0)) + '\\n... truncated, see the artifact' : c.text;\n  return `<details><summary><code>${c.label}</code></summary>\n\n\\`\\`\\`hcl\n${text}\n\\`\\`\\`\n\n</details>`;\n}).join('\\n');\n\nconst out = header + '\\n' + details;\nconst { data: comments } = await github.rest.issues.listComments({\n  ...context.repo, issue_number: context.issue.number });\nconst prev = comments.find(c => c.body.startsWith(tag));\nprev\n  ? await github.rest.issues.updateComment({ ...context.repo, comment_id: prev.id, body: out })\n  : await github.rest.issues.createComment({ ...context.repo, issue_number: context.issue.number, body: out });\n"
            }
