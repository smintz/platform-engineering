          "plan_gke_asia_southeast3_cart_infra",
          "plan_gke_asia_southeast3_checkout_infra",
          "plan_gke_asia_southeast3_cluster_infra",
          "plan_gke_asia_southeast3_currency_infra",
          "plan_gke_asia_southeast3_email_infra",
          "plan_gke_asia_southeast3_flagd_ui_infra",
          "plan_gke_asia_southeast3_flagd_infra",
          "plan_gke_asia_southeast3_frontend_proxy_infra",
          "plan_gke_asia_southeast3_frontend_infra",
          "plan_gke_asia_southeast3_grafana_infra",
          "plan_gke_asia_southeast3_image_provider_infra",
          "plan_gke_asia_southeast3_jaeger_infra",
          "plan_gke_asia_southeast3_load_generator_infra",
          "plan_gke_asia_southeast3_network_infra",
          "plan_gke_asia_southeast3_otel_collector_infra",
          "plan_gke_asia_southeast3_payment_infra",
          "plan_gke_asia_southeast3_product_catalog_infra",
          "plan_gke_asia_southeast3_prometheus_infra",
          "plan_gke_asia_southeast3_quote_infra",
          "plan_gke_asia_southeast3_recommendation_infra",
