load("@gke//gke.pinc", "gke")
load("@platform//platform/platform.pinc", "platform")
load("@terraform_state//terraform.pinc", "GCSBackend")
load("//google/protobuf/struct.proto", "ListValue", "Value")

# A VPC and a GKE cluster in one GCP project: a workspace that declares which pieces of the
# GKE driver it wants and where they land. The components themselves are the driver's
# (drivers/cluster/gke), and the otel demo builds its own cluster from the same ones.
#
# Only two of these components own a Terraform state — the network and the cluster. The
# subnet, router and NAT have none: each adds its resources to the network's state instead,
# so they compose as separate declarations and still apply as one thing.

# The one value to change before applying. The state bucket is named after it.
PROJECT = "home-run-it"
REGION = "asia-southeast3"

# What the resources are called in GCP, and the failure domain their state is keyed by. Both
# are this workspace's own: the otel demo provisions a cluster from the same driver, and two
# clusters in one project can share neither resource names nor a state prefix.
NAME = "standalone"
DOMAIN = NAME + "-" + REGION

# Every state in one bucket, keyed by failure domain and component. `make bucket` creates it.
BACKEND = GCSBackend(PROJECT + "-tfstate", lambda domain, name: "%s/%s" % (domain, name))

# What the driver needs to know about this project: everything organisation-specific is
# here, and the components are the same whoever calls them.
GCP = gke.Gcp(project = PROJECT, region = REGION, name = NAME, backend = BACKEND)

# The subnet the cluster sits on: nodes in the primary range, pods and Services in the two
# secondary ones. A second subnet is a second call, listed in the network below.
SUBNET = gke.Subnet(GCP, NAME, "10.0.0.0/20", "10.4.0.0/14", "10.8.0.0/20")

# The network, and everything that lives in it. Each piece is a component that adds itself
# here rather than taking a state of its own.
def Network(*hooks):
    return gke.Network(
        GCP,
        platform.WithDeps(SUBNET.component, gke.Router(GCP), gke.Nat(GCP)),
        *hooks
    )

ClusterComponent = gke.Cluster(GCP, Network, SUBNET)

def main():
    root = ClusterComponent(platform.WithFailureDomain(DOMAIN)).msg
    configs = platform.GetConfigs(root)

    # The order the states apply in, derived rather than declared: SelectComponents walks
    # upstreams before the component that declared them, so nothing here lands before the
    # state it reads. `make apply` follows this file and `make destroy` reverses it.
    # A component that wrote no config of its own is not a state and is not in the list.
    order = []
    for component in platform.SelectComponents(root, lambda component: True):
        prefix = "%s/%s/" % (component.domain, component.name)
        if component.name in order:
            continue
        for key in configs:
            if key.startswith(prefix):
                order.append(component.name)
                break
    configs["apply-order.json"] = ListValue(values = [Value(string_value = name) for name in order])
    return configs
