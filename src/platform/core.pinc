load("//platform/v1/platform.proto", component_proto = "Component")
load("//terraform/v1/util.pinc", tf = "util")
load("any.star", "any")

def chain(msg, *hooks):
    if not hooks:
        return msg

    queue = list(hooks)

    def run_next(current):
        if not queue:
            return current

        next_hook = queue.pop(0)
        return next_hook(current, run_next)

    first = queue.pop(0)
    return first(msg, run_next)

def flatten(hooks):
    flat = []
    for h in hooks:
        if type(h) in ("tuple", "list"):
            flat.extend(h)
        else:
            flat.append(h)
    return flat

# message_filter wraps hooks so they only run on messages of p's type (p may be
# a message type or an instance); anything else passes straight through.
def message_filter(p, *hooks):
    want = type(p)

    def wrapper(msg, next):
        if type(msg) != want:
            return next(msg)

        queue = list(hooks)

        def run_next(current):
            if not queue:
                return next(current)
            return queue.pop(0)(current, run_next)

        return run_next(msg)

    return wrapper

def component_filter(*hooks):
    return message_filter(component_proto, *hooks)

def terraform_filter(*hooks):
    return message_filter(tf.Terraform(), *hooks)

# TerraformConfig turns a ready-made Terraform message into a Terraform-typed hook.
def TerraformConfig(terraform):
    return terraform_filter(tf.From(terraform))

# Markers are not hooks: Component pulls them out of its hook list and acts on them
# itself, because what they describe cannot be expressed as "mutate this message".

# WithDeps declares upstream dependencies as uninstantiated component factories. Component
# builds each one with its inherited hooks, appends it as an upstream and runs the dep's
# ForDownstream hooks. Each factory takes hooks: def MyComponent(*hooks).
def WithDeps(*deps):
    return module("WithDeps", kind = "deps", deps = deps)

# ForDownstream defers hooks instead of running them on the component that declares
# them: they are parked on the component module and only fire when that component is
# added as an upstream (see WithDeps), with the downstream component as the message.
def ForDownstream(*hooks):
    return module("ForDownstream", kind = "downstream", hooks = hooks)

# Finally defers hooks to the end of this component's own construction: after every other
# hook and after dependencies are wired. Anything that has to see the finished component —
# rendering a view of what was declared, rather than declaring more — belongs here, because
# a hook that runs mid-chain can only see the half of the component built before it.
def Finally(*hooks):
    return module("Finally", kind = "finalize", hooks = hooks)

# Inherit marks hooks that also apply to every dependency declared with WithDeps, and to
# their dependencies in turn.
def Inherit(*hooks):
    return module("Inherit", kind = "inherit", hooks = hooks)

# mutate_config is the primitive every config write goes through — usable by any hook
# that already holds the component message. WithConfig is its declarative wrapper.
def mutate_config(component, key, *hooks):
    cfg_any = component.configs.get(key)

    # ponytail: configs default to Terraform; a non-Terraform config can be set (a bare
    # message below) but not re-opened, since unpack needs a target type.
    cfg = any.unpack(cfg_any, tf.Terraform()) if cfg_any else tf.Terraform()

    # a bare message stands for "replace the config with this one", like tf.From
    hooks = [h if type(h) == "function" else tf.From(h) for h in hooks]
    component.configs[key] = any.new(chain(cfg, *hooks))
    return component

# WithDescription sets the component's human-readable description.
def WithDescription(description):
    def do(component, next):
        component.description = description
        return next(component)

    return component_filter(do)

# WithConfig is a component-typed hook that mutates one of the component's configs.
# A None key means the main config.
def WithConfig(key, *hooks):
    def do(component, next):
        mutate_config(component, key or MAIN_CONFIG, *hooks)
        return next(component)

    return component_filter(do)

# WithFailureDomain sets the component's failure domain: the identifier of a group of
# components that fail together — a region, an AZ, a cell, whatever the blast radius is.
# It is inherited: a dependency shares the blast radius of the thing that depends on it.
def WithFailureDomain(domain):
    def do(component, next):
        component.domain = domain
        return next(component)

    return Inherit(component_filter(do))

# WithLabels declares the shape of a component: the keys a policy, a cost centre or a
# hardening rule selects on later. It writes Metadata.labels rather than Metadata.tags
# because one keyed vocabulary can answer "which components matched, and on what value";
# a bare tag set cannot, and two vocabularies answering the same question can disagree.
# Ordinary component_filter, not Inherit: whether a label should reach a component's whole
# dependency subtree is a question about that label, not about labelling, and an inheriting
# variant is a one-word change the day something needs one.
def WithLabels(**labels):
    def do(component, next):
        # proto3 nested messages are unset until assigned, the same reason Component
        # constructs Upstreams before appending to it
        if not component.metadata:
            component.metadata = component_proto.Metadata()
        for key, value in labels.items():
            component.metadata.labels[key] = value
        return next(component)

    return component_filter(do)

MAIN_CONFIG = "infra/main.tf.json"

# config type_url -> prototype, for unpacking in GetConfigs
CONFIG_TYPES = {
    "type.googleapis.com/terraform.v1.Terraform": tf.Terraform,
}

def Component(slug, *hooks):
    # a macro that has to declare several hooks at once returns them as a tuple, so the
    # call site stays one line and the pieces cannot be split up by accident
    hooks = flatten(hooks)
    markers = [h for h in hooks if type(h) == "module"]
    deferred = [h for m in markers if m.kind == "downstream" for h in m.hooks]
    inherited = [h for m in markers if m.kind == "inherit" for h in m.hooks]
    deps = [d for m in markers if m.kind == "deps" for d in m.deps]
    finalizers = [h for m in markers if m.kind == "finalize" for h in m.hooks]

    # inherited first: it is ambient context (failure domain, environment), and local
    # hooks read it — a hook that derives a value from component.domain has to run after
    # whatever set the domain.
    hooks = inherited + [h for h in hooks if type(h) != "module"]

    component = component_proto(name = slug)

    # Main config first: hooks that run later (a dep's ForDownstream hooks) mutate
    # configs, and TerraformConfig would otherwise replace them.
    # Same hook list, different message type: only the Terraform-typed hooks fire here.
    mutate_config(component, MAIN_CONFIG, *hooks)
    component = chain(component, *hooks)

    # Deps are built after the chain, so they inherit a fully-populated component.
    if deps and not component.upstreams:
        component.upstreams = component_proto.Upstreams()
    for dep_factory in deps:
        dep = dep_factory(Inherit(*inherited))
        component.upstreams.components.append(dep.msg)
        dep.RunForDownstream(component)

    # after dependencies, so a finalizer also sees whatever they contributed
    component = chain(component, *finalizers)

    # ponytail: deferred hooks see the downstream component only; reach this component
    # through downstream.upstreams if a hook ever needs to mutate both.
    def RunForDownstream(downstream):
        return chain(downstream, *deferred)

    return module(
        "Component",
        msg = component,
        RunForDownstream = RunForDownstream,
    )

# walk_upstreams visits every component in the graph depth-first, upstreams before the
# component that declared them, and hands each one to `visit`. It lives at module level
# rather than nested inside GetConfigs because SelectComponents needs exactly this order
# over exactly this graph: two traversals are two things that can disagree about what the
# graph is, and the one that disagrees silently is the selector nobody is checking.
# The parameter is `visit` and not this file's usual `next`: `next` means "call the next
# hook and return its result" everywhere else here, and this function discards every
# recursive return value. A caller who read the name literally and passed a transforming
# hook would lose every upstream result with nothing to show for it.
def walk_upstreams(component, visit):
    if not component.upstreams:
        return visit(component)
    for upstream in component.upstreams.components:
        walk_upstreams(upstream, visit)
    return visit(component)

# SelectComponents returns every OCCURRENCE the `predicate` accepts in the graph rooted at
# `component`, in the post-order walk_upstreams produces. Every occurrence, not one entry
# per distinct content: Component builds each dependency factory once per parent, so the
# two arms of a diamond hold two DISTINCT live objects that merely happen to be equal, and
# a caller handed one of them has silently skipped a component. Skipping is what the
# consumers of this list cannot survive — a hardening hook or a cost centre applied across
# a selection has to reach every live object, and an audit built on a selection that
# under-reports is wrong in the direction that looks fine.
# The dict this used to collect into keyed by proto VALUE, so it collapsed those two
# objects, and the collapse was neither complete nor idempotent: it returned whichever of
# the two the traversal inserted first, and a mutation through that one made the contents
# differ, so the next selection returned both. The answer depended on mutation history.
# A caller that wants a unique view builds one, visibly, from a key it chose and can be
# held to. Keying on "<domain>/<name>" here would assert a uniqueness platform.proto does
# not enforce, and would make that assertion the platform's rather than the caller's.
# No match returns an empty list rather than failing: a caller that needs a zero match to
# be an error knows what it was asking for and can say so; this one does not.
def SelectComponents(component, predicate):
    found = []

    def collect(c):
        if predicate(c):
            found.append(c)

    walk_upstreams(component, collect)
    return found

# GetConfigs walks a Component and its upstreams, and returns a map of all the Terraform
# configs keyed by "<domain>/<name>/<config name>". Components store their configs under
# the bare config name; the prefix is only applied here, once the whole component chain
# has run and domain/name are final.
# `types` registers a workspace's own config messages the same way CONFIG_TYPES registers
# Terraform: a service's config file, say, set on the component under a key like
# "infra/config.yaml" and rendered beside its state in the format the extension names. The
# platform cannot know those messages, so whoever declares them passes them in.
def GetConfigs(component, types = {}):
    known = {}
    known.update(CONFIG_TYPES)
    known.update(types)
    configs = {}

    def collect_configs(component):
        prefix = "/".join([p for p in (component.domain, component.name) if p])
        for key, cfg_any in component.configs.items():
            # configs hold two kinds of message: the ones that become a file, and the ones
            # a driver parks on the component as working state — the ECS task spec a
            # sidecar contributes to, say. Only the first kind is registered here, and only
            # it is rendered; the rest is somebody's scratch space and none of our business.
            if cfg_any.type_url not in known:
                continue
            proto = known[cfg_any.type_url]
            cfg = any.unpack(cfg_any, proto())

            # a component that provisions nothing of its own — its whole job is the hooks
            # it hands to dependants — should not emit an empty config file
            if str(cfg) == str(proto()):
                continue
            configs[prefix + "/" + key] = cfg

    walk_upstreams(component, collect_configs)

    return configs
