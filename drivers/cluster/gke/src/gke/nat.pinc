load("@platform//platform/platform.pinc", "platform")
load("@platform//terraform/v1/util.pinc", "util")
load("//gke/router.pinc", "ROUTER_NAME")
load("//terraform/googlecloud/resources/v8/compute.proto", "GoogleComputeRouterNat")

# Egress for everything with no public address: private GKE nodes reach a registry through
# this, and nothing reaches them. It covers every subnet on the network, including ones
# added after it, which is why it is one component rather than a field on each subnet.
#
# Stateless, and declared alongside the router it attaches to — both are dependencies of the
# same network, and it names the router's resource because they land in one state. Declaring
# the router as its own dependency instead would pull the router's resources into *this*
# component's config, and this component owns no state to put them in.
def Nat(gcp):
    def component(*hooks):
        return platform.Component(
            "nat",
            platform.WithDescription("Cloud NAT: egress for private nodes"),
            platform.ForDownstream(platform.WithConfig(
                None,
                util.Resource(
                    "nat",
                    GoogleComputeRouterNat(
                        name = gcp.name,
                        region = gcp.region,
                        router = ROUTER_NAME,
                        nat_ip_allocate_option = "AUTO_ONLY",
                        source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES",
                    ),
                ),
            )),
            *hooks
        )

    return component
