load("@platform//terraform/v1/util.pinc", "util")
load("//terraform/kubernetes/provider/v3/kubernetes.proto", "Kubernetes")
load("//terraform/kubernetes/resources/v3/config.proto", "KubernetesConfigMapV1")
load("//terraform/kubernetes/resources/v3/deployment.proto", KubernetesDeployment = "KubernetesDeploymentV1")
load("//terraform/kubernetes/resources/v3/service.proto", KubernetesService = "KubernetesServiceV1")

# Kubernetes runtime driver: how a component's process is deployed and addressed.
#
# The sibling of ecs.pinc, and the reason both exist separately rather than behind one
# "runtime" interface: what a workload *is* differs between them. An ECS task is a task
# definition plus a service plus the IAM roles they assume; a Kubernetes workload is a
# Deployment plus a Service, and its address is a DNS name the cluster resolves rather
# than something Terraform has to publish. An interface wide enough to cover both would
# be a union of the two, which is the same as neither.

Pod = KubernetesDeployment.Spec.Template.Spec
Container = Pod.Container

# Terraform's kubernetes provider reads no kubeconfig unless it is pointed at one: with
# config_path unset it assumes it is running inside the cluster it is configuring, and an
# apply from a laptop or a runner fails trying to reach an in-cluster API address. Pointing
# it at the kubeconfig is what makes `terraform apply` land on the cluster `kubectl` is
# already talking to.
KUBECONFIG = "~/.kube/config"

# KubeConfig is that provider. An unset context means the kubeconfig's current-context —
# whatever `kubectl config current-context` prints — which is what a person running this by
# hand wants and is why it is the default.
#
# Naming a context pins the cluster instead. Anything unattended should: current-context is
# per-machine mutable state, so a pipeline that leaves it unset applies to whichever cluster
# the runner happened to be pointed at, and that is not a failure Terraform can catch.
# config_context is set only when asked for: the provider proto is proto2, so a field
# assigned the empty string is *present and empty* rather than absent, and the provider
# reads an empty config_context as "a context named ''" rather than as the current one.
def KubeConfig(context = "", path = KUBECONFIG):
    provider = Kubernetes(config_path = path)
    if context:
        provider.config_context = context
    return provider

# Workload is one process as Kubernetes deploys it: a Deployment of `image` and a
# ClusterIP Service in front of it, both selected by app=<name>. That selector is what
# makes the workload's address its own name — which is what lets a dependency hand its
# address to a dependant (see WithContainerEnv) without either one publishing a value
# through Terraform.
def Workload(name, image, port, provider = None):
    labels = {"app": name}
    return util.Group(
        # explicit None check: an all-default Kubernetes() is falsy, and passing one is how
        # a caller asks for in-cluster credentials rather than for the default below
        util.Provider(KubeConfig() if provider == None else provider),
        util.Resource(
            name,
            KubernetesDeployment(
                metadata = KubernetesDeployment.Metadata(name = name, labels = labels),
                spec = KubernetesDeployment.Spec(
                    selector = KubernetesDeployment.Spec.Selector(
                        match_labels = labels,
                    ),
                    template = KubernetesDeployment.Spec.Template(
                        metadata = KubernetesDeployment.Spec.Template.Metadata(
                            labels = labels,
                        ),
                        spec = Pod(
                            container = [Container(
                                name = name,
                                image = image,
                                port = [Container.Port(container_port = port)],
                            )],
                        ),
                    ),
                ),
            ),
        ),
        util.Resource(
            name,
            KubernetesService(
                metadata = KubernetesService.Metadata(name = name, labels = labels),
                spec = KubernetesService.Spec(
                    selector = labels,
                    port = [KubernetesService.Spec.Port(
                        port = port,
                        target_port = str(port),
                    )],
                ),
            ),
        ),
    )

# Every hook below edits every Deployment in the config it runs against, the way
# WithContainerEnv always has: a hook describes the process, not which resource name the
# workload happened to render it under.
def _pods(config):
    return [d.spec.template.spec for d in config.resource.kubernetes_deployment_v1.values()]

def _containers(config):
    return [c for pod in _pods(config) for c in pod.container]

# WithContainerEnv sets a variable on every container in the config it runs against. Meant
# for a dependency's ForDownstream hooks — the same channel ecs.pinc spells WithTaskEnv:
# the dependency knows its own address and hands it over without knowing which workload
# the dependant deploys, or how many containers that workload turned out to have.
def WithContainerEnv(name, value):
    def do(config, next):
        for container in _containers(config):
            container.env.append(Container.Env(name = name, value = value))
        return next(config)

    return do

# WithCommand replaces the image's entrypoint. The whole argv, not a suffix: an image whose
# entrypoint is a shell script and one whose entrypoint is the binary need different lists,
# and only the caller knows which it is running.
def WithCommand(*command):
    def do(config, next):
        for container in _containers(config):
            container.command = list(command)
        return next(config)

    return do

# WithMemoryLimit caps the container's memory. A limit rather than a request: it is what
# the kernel enforces, and what makes an over-budget process restart instead of starving
# its neighbours on a shared node.
def WithMemoryLimit(memory):
    def do(config, next):
        for container in _containers(config):
            if not container.resources:
                container.resources = Container.Resources()
            container.resources.limits["memory"] = memory
        return next(config)

    return do

# WithPort exposes one more port on the workload and its Service. Kubernetes requires every
# port of a multi-port Service to be named, so the first one — unnamed, as Workload renders
# it — is named after its number the moment a second one arrives.
def WithPort(name, port):
    def do(config, next):
        for container in _containers(config):
            container.port.append(Container.Port(name = name, container_port = port))
        for service in config.resource.kubernetes_service_v1.values():
            for existing in service.spec.port:
                if not existing.name:
                    existing.name = "port-%d" % existing.port
            service.spec.port.append(
                KubernetesService.Spec.Port(name = name, port = port, target_port = str(port)),
            )
        return next(config)

    return do

# WithScratchDir mounts a writable directory that lives as long as the pod rather than the
# container: a process that crashes and is restarted finds what it wrote still there, and
# only replacing the pod — a new image, a changed spec — starts it empty. For state a
# process can rebuild but should not lose on every restart.
def WithScratchDir(name, mount_path):
    def do(config, next):
        for pod in _pods(config):
            pod.volume.append(Pod.Volume(name = name, empty_dir = Pod.Volume.EmptyDir()))
        for container in _containers(config):
            container.volume_mount.append(Container.VolumeMount(name = name, mount_path = mount_path))
        return next(config)

    return do

# WithConfigFiles mounts files into every container: a ConfigMap named `name` holding
# `data` (file name -> contents), mounted read-only at `mount_path`. With `sub_path`, only
# that one key is mounted, at exactly `mount_path` — for a process that reads a single file
# from a directory the image already populates.
#
# The volume names the ConfigMap through a Terraform reference rather than the literal
# name, so Terraform creates the ConfigMap before the Deployment that mounts it.
# ponytail: a changed ConfigMap does not restart the pods reading it; add a content-hash
# annotation on the pod template if a config edit must roll the workload.
def WithConfigFiles(name, mount_path, data, sub_path = ""):
    def mount(config, next):
        ref = "${kubernetes_config_map_v1.%s.metadata[0].name}" % name
        for pod in _pods(config):
            pod.volume.append(Pod.Volume(name = name, config_map = Pod.Volume.ConfigMap(name = ref)))
        for container in _containers(config):
            container.volume_mount.append(Container.VolumeMount(
                name = name,
                mount_path = mount_path,
                sub_path = sub_path,
                read_only = True,
            ))
        return next(config)

    return util.Group(
        util.Resource(
            name,
            KubernetesConfigMapV1(
                metadata = KubernetesConfigMapV1.Metadata(name = name),
                data = data,
            ),
        ),
        mount,
    )
