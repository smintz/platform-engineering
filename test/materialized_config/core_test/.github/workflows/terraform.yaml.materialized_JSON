            "run": "set -euo pipefail\n\nws=\"${{ vars.GRAFANA_WORKSPACE_ID }}\"\naccount=\"protoconf-plan\"\n\nsa=$(aws grafana list-workspace-service-accounts --workspace-id \"$ws\" \\\n  --query \"serviceAccounts[?name=='$account'].id | [0]\" --output text)\nif [ -z \"$sa\" ] || [ \"$sa\" = \"None\" ]; then\n  echo \"::error::no Grafana service account named $account in workspace $ws - apply the grafana state first\"\n  exit 1\nfi\n\n# Grafana keeps expired tokens on the account, and this job cannot touch the live ones\n# belonging to the jobs running beside it, so it collects the dead and leaves the rest.\nnow=$(date -u +%Y-%m-%dT%H:%M:%SZ)\naws grafana list-workspace-service-account-tokens --workspace-id \"$ws\" --service-account-id \"$sa\" \\\n  | jq -r --arg now \"$now\" '.serviceAccountTokens[] | select(.expiresAt[0:19] < $now[0:19]) | .id' \\\n  | while read -r dead; do\n      aws grafana delete-workspace-service-account-token \\\n        --workspace-id \"$ws\" --service-account-id \"$sa\" --token-id \"$dead\" >/dev/null || true\n    done\n\nkey=$(aws grafana create-workspace-service-account-token --workspace-id \"$ws\" --service-account-id \"$sa\" \\\n  --name \"gha-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB\" --seconds-to-live 1800 \\\n  --query 'serviceAccountToken.key' --output text)\necho \"::add-mask::$key\"\n\n{\n  echo \"GRAFANA_AUTH=$key\"\n  echo \"GRAFANA_URL=https://$(aws grafana describe-workspace --workspace-id \"$ws\" \\\n    --query 'workspace.endpoint' --output text)\"\n} >> \"$GITHUB_ENV\"\n"
          },
          {
            "id": "setup-terraform",
            "uses": "hashicorp/setup-terraform@v3",
            "with": {
              "terraform_version": "1.9.8",
              "terraform_wrapper": false
            }
          },
          {
            "id": "plugin-cache-dir",
            "run": "mkdir -p /home/runner/.terraform.d/plugin-cache"
          },
          {
            "id": "plugin-cache",
            "uses": "actions/cache@v4",
            "with": {
              "key": "tf-plugins-test_outputs_core_test_us_east_1_redis_monitoring-${{ hashFiles('test/outputs/core_test/us-east-1/redis/monitoring/.terraform.lock.hcl') }}",
              "path": "/home/runner/.terraform.d/plugin-cache",
              "restore-keys": "tf-plugins-test_outputs_core_test_us_east_1_redis_monitoring-"
            }
          },
          {
            "id": "init",
            "run": "terraform init -lock-timeout=5m"
          },
          {
            "id": "validate",
            "run": "terraform validate -no-color"
          },
          {
            "id": "plan",
            "run": "set +e\nterraform plan -detailed-exitcode -lock-timeout=5m -out=tfplan\ncode=$?\nset -e\ncase $code in\n  0) echo \"changes=false\" >> \"$GITHUB_OUTPUT\" ;;\n  2) echo \"changes=true\"  >> \"$GITHUB_OUTPUT\" ;;\n  *) exit $code ;;\nesac\nterraform show -no-color tfplan > plan.txt\n"
          },
          {
            "id": "upload-plan",
            "uses": "actions/upload-artifact@v4",
            "with": {
              "name": "tfplan-us_east_1_redis_monitoring-${{ github.run_id }}",
              "path": "test/outputs/core_test/us-east-1/redis/monitoring/tfplan\ntest/outputs/core_test/us-east-1/redis/monitoring/plan.txt\n",
              "retention-days": 5
            }
          },
          {
            "id": "drift",
            "if": "github.event_name == 'schedule' && steps.plan.outputs.changes == 'true'",
            "run": "echo \"::error::drift detected in us-east-1/redis/monitoring\"\nexit 1"
          }
        ],
        "outputs": {
          "changes": "${{ steps.plan.outputs.changes }}"
        }
      },
      "pr_comment": {
        "name": "comment",
        "needs": [
          "plan_us_east_1_api_task_infra",
          "plan_us_east_1_api_task_monitoring",
          "plan_us_east_1_redis_infra",
          "plan_us_east_1_redis_monitoring"
        ],
        "runs-on": "ubuntu-latest",
        "if": "always() && github.event_name == 'pull_request'",
        "steps": [
          {
            "id": "download-plans",
            "uses": "actions/download-artifact@v4",
            "continue-on-error": true,
            "with": {
              "path": "plans",
              "pattern": "tfplan-*-${{ github.run_id }}"
            }
          },
          {
            "id": "comment",
            "uses": "actions/github-script@v7",
            "env": {
              "NEEDS": "${{ toJSON(needs) }}",
              "PLANS": "[{\"job\":\"plan_us_east_1_api_task_infra\",\"label\":\"us-east-1/api-task/infra\",\"slug\":\"us_east_1_api_task_infra\"},{\"job\":\"plan_us_east_1_api_task_monitoring\",\"label\":\"us-east-1/api-task/monitoring\",\"slug\":\"us_east_1_api_task_monitoring\"},{\"job\":\"plan_us_east_1_redis_infra\",\"label\":\"us-east-1/redis/infra\",\"slug\":\"us_east_1_redis_infra\"},{\"job\":\"plan_us_east_1_redis_monitoring\",\"label\":\"us-east-1/redis/monitoring\",\"slug\":\"us_east_1_redis_monitoring\"}]"
            },
            "with": {
              "script": "const fs = require('fs');\nconst tag = '<!-- tf-plan -->';\nconst plans = JSON.parse(process.env.PLANS);\nconst needs = JSON.parse(process.env.NEEDS);\nconst runId = process.env.GITHUB_RUN_ID;\n\n// GitHub rejects a comment over 65536 characters, and a rejected comment says nothing at\n// all about any state. Everything below is spent staying under that.\nconst BUDGET = 60000;\n\n// Every plan is uploaded as an artifact; its id is what a link to it needs, and only the\n// API knows it. A run can upload more than a page of them, so page through.\nconst artifacts = await github.paginate(github.rest.actions.listWorkflowRunArtifacts, {\n  ...context.repo, run_id: runId, per_page: 100 });\nconst artifactUrl = Object.fromEntries(artifacts.map(a => [a.name,\n  `${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${runId}/artifacts/${a.id}`]));\n\n// The line a reader wants from a plan is its last one: \"Plan: 2 to add, 0 to change, 0 to\n// destroy.\" (with \"N to import\" first when there are imports). It is always complete,\n// however large the plan, which is what the table needs — the plans themselves are\n// truncated below to fit the comment, and this line is how a reader knows what was cut.\n// A plan that only changes outputs has no such line; its \"Changes to Outputs:\" heading is\n// the tell.\nfunction summary(text) {\n  const plan = text.match(/^Plan: .*$/m);\n  if (plan) return plan[0];\n  if (/^Changes to Outputs:/m.test(text)) return 'Outputs only';\n  return 'changes';\n}\n\nconst rows = [];\nconst changed = [];\nfor (const p of plans) {\n  const job = needs[p.job] || {};\n  const result = job.result || 'skipped';\n  const changes = (job.outputs || {}).changes;\n  const artifact = `tfplan-${p.slug}-${runId}`;\n  const name = '`' + p.label + '`' + (p.frozen ? ` (frozen: ${p.frozen})` : '');\n  if (result !== 'success' || changes !== 'true') {\n    rows.push(`| ${name} | ${result === 'success' ? 'No changes.' : result} |`);\n    continue;\n  }\n  let text = null;\n  try {\n    text = fs.readFileSync(`plans/${artifact}/plan.txt`, 'utf8');\n  } catch (e) {\n    core.warning(`no plan artifact for ${p.label}`);\n  }\n  const line = text === null ? 'changes' : summary(text);\n  const url = artifactUrl[artifact];\n  rows.push(`| ${name} | ${url ? `[${line}](${url})` : line} |`);\n  if (text !== null) changed.push({ label: p.label, text, url });\n}\n\nconst header = `${tag}\n### Terraform plan\n\n| state | plan |\n| --- | --- |\n${rows.join('\\n')}\n`;\n\n// Only the states that changed are worth showing, and they share what is left of the\n// budget equally, so one enormous plan cannot crowd every other state out of the comment.\nconst share = changed.length ? Math.floor((BUDGET - header.length) / changed.length) - 200 : 0;\nconst details = changed.map(c => {\n  const text = c.text.length > share ? c.text.slice(0, Math.max(share, 0)) + '\\n... truncated' : c.text;\n  const more = c.text.length > share && c.url ? `\\n\\nTruncated to fit the comment — [the whole plan](${c.url}).` : '';\n  return `<details><summary><code>${c.label}</code></summary>\n\n\\`\\`\\`hcl\n${text}\n\\`\\`\\`${more}\n\n</details>`;\n}).join('\\n');\n\nconst out = header + '\\n' + details;\nconst { data: comments } = await github.rest.issues.listComments({\n  ...context.repo, issue_number: context.issue.number });\nconst prev = comments.find(c => c.body.startsWith(tag));\nprev\n  ? await github.rest.issues.updateComment({ ...context.repo, comment_id: prev.id, body: out })\n  : await github.rest.issues.createComment({ ...context.repo, issue_number: context.issue.number, body: out });\n"
            }
          }
        ]
      }
    }
  }
}