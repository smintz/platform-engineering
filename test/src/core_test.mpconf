load("@github_actions//github_actions.pinc", "actions")
load("@grafana//grafana.pinc", "WithGrafanaDashboard")
load("@kubernetes//kubernetes.pinc", "WithContainerEnv", "Workload")
load("@terraform_state//terraform.pinc", "S3Backend", "WithState")
load("@platform//platform/platform.pinc", "platform")

# Where every state in this stack lives. One bucket, keyed by failure domain and state
# name, which is also what lets the pipeline below recover the order states apply in.
BACKEND = S3Backend(
    "platform-engineering-tfstate",
    "us-east-1",
    lambda domain, name: "%s/%s.tfstate" % (domain, name),
)

# What this organisation called its datasources; the drivers only know the kinds.
DATASOURCES = {"prometheus": "Prometheus"}

# Where the compiler writes this file's outputs, as seen from the repository root: the
# workflow is installed at the root (GitHub reads nowhere else) and every path in it —
# working directories, the paths filter — is resolved from there.
OUTPUT_ROOT = "test/outputs/core_test"

# Redis is measured where it is consumed rather than at the process: `redis_up` is the
# exporter's view of whether a connection and a PING succeeded, which is the same failure
# the API sees. Averaging it over the window is good scrapes over scrapes attempted, so a
# quiet period neither flatters nor penalises the number.
REDIS_UP = 'avg_over_time(redis_up{job="redis"}[%s])'

# Availability and latency for the API, both as good/valid over the window. The denominator
# is every request the API answered — not every request it answered successfully — because
# a service that stops accepting traffic must not look reliable for having none.
API_AVAILABILITY = """\
sum(rate(http_requests_total{job="api-task",code!~"5.."}[%s]))
  / sum(rate(http_requests_total{job="api-task"}[%s]))"""

API_LATENCY = """\
sum(rate(http_request_duration_seconds_bucket{job="api-task",le="0.3"}[%s]))
  / sum(rate(http_request_duration_seconds_count{job="api-task"}[%s]))"""

# 28 days: four weekends, and no reset on the first of the month.
WINDOW = "28d"

# The burn queries are the same ratio over whatever window the alert rule is evaluating;
# the driver substitutes its own windows into the token.
BURN = "$__window"

def RedisComponent(*hooks):
    return platform.Component(
        "redis",
        WithState(BACKEND, lambda component: Workload("redis", "redis:7-alpine", 6379)),
        platform.WithSLO(
            "availability",
            REDIS_UP % WINDOW,
            description = "Share of scrapes where Redis accepted a connection and answered PING. The API keeps no local cache, so a Redis that is down is an API that is down.",
            min = 0.999,
            unit = platform.Unit.UNIT_RATIO,
            severity = platform.Status.STATUS_CRIT,
            burn_query = REDIS_UP % BURN,
        ),
        # a cause, not a promise: it is here to explain an availability dip, not to page
        platform.WithDiagnostic(
            "memory used",
            'redis_memory_used_bytes{job="redis"}',
            description = "Approaching maxmemory is what turns a healthy Redis into one that starts evicting keys the API expected to find.",
            unit = platform.Unit.UNIT_BYTES,
        ),
        WithGrafanaDashboard(BACKEND, DATASOURCES),
        # runs on the downstream component, writing into its own main.tf.json
        platform.ForDownstream(
            platform.WithConfig(None, WithContainerEnv("REDIS_URL", "redis://redis:6379")),
        ),
        *hooks
    )

def ApiTaskComponent(*hooks):
    return platform.Component(
        "api-task",
        WithState(
            BACKEND,
            lambda component: Workload("api-task", "ghcr.io/example/api:latest", 8080),
        ),
        platform.WithSLO(
            "availability",
            API_AVAILABILITY % (WINDOW, WINDOW),
            description = "Share of requests the API answered without a 5xx. 99.5% over 28 days leaves about 3.5 hours of budget, which is what the service has historically spent on deploys and Redis failovers together.",
            min = 0.995,
            unit = platform.Unit.UNIT_RATIO,
            severity = platform.Status.STATUS_CRIT,
            burn_query = API_AVAILABILITY % (BURN, BURN),
        ),
        platform.WithSLO(
            "latency",
            API_LATENCY % (WINDOW, WINDOW),
            description = "Share of requests served in under 300ms. Measured at the server, so it misses whatever the network adds on the way to the caller.",
            min = 0.99,
            unit = platform.Unit.UNIT_RATIO,
            burn_query = API_LATENCY % (BURN, BURN),
        ),
        platform.WithDiagnostic(
            "pod restarts",
            'sum(increase(kube_pod_container_status_restarts_total{container="api-task"}[1h]))',
            description = "Restarts do not break the objectives on their own — Kubernetes takes a restarting pod out of the Service — but a crash loop is usually the first thing to check when availability drops.",
            unit = platform.Unit.UNIT_COUNT,
        ),
        WithGrafanaDashboard(BACKEND, DATASOURCES),
        # uninstantiated: Component calls it with the hooks marked Inherit
        platform.WithDeps(RedisComponent),
        *hooks
    )

def main():
    configs = platform.GetConfigs(
        ApiTaskComponent(platform.WithFailureDomain("us-east-1")).msg,
    )

    outputs = {}
    outputs.update(configs)

    # The pipeline is derived from the configs rather than declared: every state gets a
    # plan on pull requests and an apply on main, ordered by whatever reads whose state.
    outputs[".github/workflows/terraform.yaml"] = actions.TerraformPipeline(
        configs,
        OUTPUT_ROOT,
        # Grafana's token is minted per job and only on the jobs whose config declares the
        # provider, so the monitoring states get one and the Kubernetes states never do.
        actions.GrafanaServiceAccountToken(
            actions.OidcCredentials("us-east-1"),
            workspace = "${{ vars.GRAFANA_WORKSPACE_ID }}",
            plan_account = "protoconf-plan",
            apply_account = "protoconf-apply",
        ),
    )
    return outputs
