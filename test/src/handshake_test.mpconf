load("@github_actions//github_actions.pinc", "actions")
load("@kubernetes//kubernetes.pinc", "Workload")
load("@platform//platform/platform.pinc", "platform")
load(
    "@terraform_state//terraform.pinc",
    "LocalBackend",
    "S3Backend",
    "WithRemoteOutput",
    "WithState",
)

# What the golden files cannot see, part two. This file exists for two reasons.
#
# First, it is the only executable assertion that the pipeline's apply-ordering derivation
# actually derives an edge. Every config in the reference stack stands alone — none of them
# declares a terraform_remote_state — so `dependencies()` returns an empty upstream list for
# all four and nothing under outputs/ or materialized_config/ can distinguish "the ordering
# works" from "the ordering has never been asked a question". This file asks it: one
# publisher, one subscriber, a correctly paired cross-state handshake, and an assertion that
# the subscriber's plan job waits on the publisher's.
#
# Second, it is the fixture the two compile gates in the CI driver are proven against.
# NEAR_BACKEND and FAR_BACKEND below are switch points: substituting LOCAL for the first and
# MISMATCHED for the second reproduces, exactly, the two silently-wrong wirings
# `_check_remote_backends` and `_check_reads_are_produced` exist to catch. Starlark cannot
# catch a fail() in-process, so those two negative checks are scripted from outside the
# compiler rather than asserted here: they are the `gates` target in test/Makefile, which
# `make test` runs, which is what CI runs.
#
# main() returns an empty dict on purpose: an .mpconf with no keys writes no output file, so
# this costs zero golden-file surface while still compiling on every `make test`.

# Where this fixture's states would live if anything ever applied them. Nothing does — the
# bucket is named as a fixture rather than as real infrastructure, because this file emits
# no Terraform at all and a plausible bucket name here would read as a second live stack.
BACKEND = S3Backend(
    "handshake-test-fixture",
    "us-east-1",
    lambda domain, name: "%s/%s.tfstate" % (domain, name),
)

# MISMATCHED and LOCAL are used by no component in this file, and they are not dead. `make
# gates` substitutes LOCAL for NEAR_BACKEND and MISMATCHED for FAR_BACKEND in a COPY of this
# file, compiles each copy, and asserts on the gate message the compiler prints — so deleting
# either constant as unreferenced turns that target red rather than disarming it quietly,
# which is the whole point of naming a command here instead of a rule.
#
# The two switch-point assignments below are anchored substitution targets: `make gates`
# matches them with `^` and `$`, so each must stay alone on its own line in exactly the form
# `NEAR_BACKEND = BACKEND` / `FAR_BACKEND = BACKEND`. A trailing comment on either line breaks
# the substitution — reported by name, because the target checks that each mutation landed
# before it draws any conclusion from the compile.
#
# They are declared ABOVE the two switch points on purpose. Starlark evaluates a module top
# to bottom, so a substitution that referred forward to a name defined later would fail with
# `undefined: MISMATCHED` before the compiler ever reached the gate the check is aimed at —
# a non-zero exit and an absent gate message, which reads exactly like a gate that stopped
# firing.
#
# MISMATCHED feeds the FOUND-05 negative check: swapped in for FAR_BACKEND it makes the
# subscriber read an s3 state no config in this pipeline writes.
MISMATCHED = S3Backend(
    "handshake-test-nobody-writes-this",
    "us-east-1",
    lambda domain, name: "%s/%s.tfstate" % (domain, name),
)

# LOCAL feeds the FOUND-04 negative check: swapped in for NEAR_BACKEND it makes both
# components hold their state on the runner's disk, which CI discards when the job ends.
LOCAL = LocalBackend()

# The backend each component's own state is written to.
NEAR_BACKEND = BACKEND

# The backend the far half of the handshake reads through. It is deliberately the same
# object the publisher writes to: a read pointing at a state this pipeline does not apply
# yields no ordering edge, which leaves the apply order arbitrary rather than merely
# unsupported. That is the pairing FOUND-05 makes mandatory, and the one asserted below.
FAR_BACKEND = BACKEND

# One failure domain for both components, so the handshake is a cross-state read rather
# than a cross-domain one — the case the DB and mesh drivers in phases 3-5 will produce.
DOMAIN = "handshake"

# Never written to: the pipeline is built and discarded, and the compiler is never asked to
# materialize it. It is here because TerraformPipeline requires a root to resolve working
# directories against, not because anything reads one.
OUTPUT_ROOT = "test/outputs/handshake_test"

# The publisher owns its own state and publishes one value out of it. WithRemoteOutput
# returns a tuple — the near half writes `output "host"` here, the far half gives every
# dependant a terraform_remote_state pointing back at this state — so it is passed as one
# positional argument and Component's flatten splices the pair. Unpacking it at the call
# site would let a future edit apply one half without the other, which is the wiring the
# handshake convention exists to make impossible.
def PublisherComponent(*hooks):
    return platform.Component(
        "pub",
        WithState(
            lambda component: Workload("pub", "ghcr.io/example/pub:latest", 8080),
            NEAR_BACKEND,
        ),
        WithRemoteOutput("host", "pub.internal", FAR_BACKEND),
        *hooks
    )

# The subscriber declares only the dependency. It never names the publisher's state, its
# bucket or its key: the far half of the handshake wrote the data source into this config,
# and the pipeline recovers the ordering edge by matching that read against the publisher's
# backend. Nobody declares the DAG, which is the property being asserted.
def SubscriberComponent(*hooks):
    return platform.Component(
        "sub",
        WithState(
            lambda component: Workload("sub", "ghcr.io/example/sub:latest", 8080),
            NEAR_BACKEND,
        ),
        platform.WithDeps(PublisherComponent),
        *hooks
    )

def main():
    configs = platform.GetConfigs(
        SubscriberComponent(platform.WithFailureDomain(DOMAIN)).msg,
    )

    # This call comes FIRST, before the assertion below, and the order is load-bearing.
    # TerraformPipeline runs the two compile gates: LOCAL is caught by _check_remote_backends
    # (github_actions.pinc:204) and MISMATCHED by _check_reads_are_produced (:239). Both
    # switch points also break the assertion below, and both have a second catcher behind the
    # gate — LOCAL collapses both backend state ids to "local://", which the duplicate-state
    # fail() inside _producers reports, and MISMATCHED leaves the subscriber with no upstream,
    # which this file's own fail() reports. Starlark cannot catch a fail(), so whichever runs
    # first ends the compile. With the assertion first, neither gate would ever be entered and
    # a gate that had quietly stopped firing would still look green — and it would still exit
    # non-zero from those second catchers, which is why `make gates` asserts on the gate's own
    # message and on the function named in the traceback rather than on the exit code. The
    # workflow it returns is asserted on below; nothing here is materialized.
    workflow = actions.TerraformPipeline(
        configs,
        OUTPUT_ROOT,
        actions.OidcCredentials("us-east-1"),
    )

    # Composed rather than hardcoded, because the key layout is GetConfigs' business:
    # "<domain>/<name>/<config key>", with the domain omitted when empty. A literal here
    # would keep passing after a change to that layout by asserting against a path the
    # compiler no longer writes.
    pub = "%s/pub/%s" % (DOMAIN, platform.MAIN_CONFIG)
    sub = "%s/sub/%s" % (DOMAIN, platform.MAIN_CONFIG)
    expected = {pub: [], sub: [pub]}

    deps = actions.dependencies(configs)
    if deps != expected:
        fail(
            ("handshake_test: the apply-ordering derivation lost the cross-state edge. " +
             "Expected %s — the subscriber's plan job waiting on the publisher's, and the " +
             "publisher waiting on nothing — but got %s. An empty upstream list for the " +
             "subscriber means its terraform_remote_state read matched no config's backend " +
             "state id, so both halves of the handshake are no longer pointed at the same " +
             "backend.") % (expected, deps),
        )

    # The edge above is only half of what the pipeline does with it. The other half is the
    # condition the plan jobs carry, and this fixture is the only place it can be asserted:
    # every state in core_test stands alone, so its generated workflow renders a plan job
    # with no upstream clause at all, and a change that dropped that clause from the driver
    # would leave every golden file in this repository byte-identical.
    #
    # What it would cost is silence of the worst kind. A state read through
    # terraform_remote_state is read live at plan time rather than from a file, so an
    # upstream apply changes what this plan would see without touching one path in this
    # state's directory. Drop the clause and the subscriber is planned only when its own
    # files change — it goes unplanned on exactly the runs where the publisher moved the
    # ground under it, and an unplanned state is indistinguishable, in a run's job list,
    # from a state with nothing to do.
    #
    # Composed from the keys for the reason they are themselves composed: the job id is the
    # key's directory with the separators collapsed, and a literal here would keep passing
    # after a change to that layout by asserting against a job the driver no longer writes.
    # Every name in this fixture is already slug-safe, so "/" is the only character the
    # driver's own transform has anything to do with; one that is not would fail below
    # naming the id it looked for, which is loud rather than quiet.
    slug = lambda key: "_".join(key.split("/")[:-1])
    own = lambda key: "contains(needs.changed_paths.outputs.changed, '\"%s\"')" % slug(key)
    applied = lambda key: "needs.apply_%s.result == 'success'" % slug(key)

    for key, upstreams in [(sub, [pub]), (pub, [])]:
        id = "plan_%s" % slug(key)
        job = workflow.jobs[id]

        # The gate job first, then the upstream applies. A plan that did not wait for the
        # gate would read an output that had not been written yet — the empty string — and
        # skip itself on every push and pull request there is.
        wanted = ["changed_paths"] + ["apply_%s" % slug(u) for u in upstreams]
        if list(job.needs) != wanted:
            fail(
                ("handshake_test: %s waits on %s, expected %s. A plan job reads the path " +
                 "gate's output and its upstream applies' results, and `needs` is what " +
                 "makes either one readable at all.") % (id, list(job.needs), wanted),
            )

        if own(key) not in job.if_condition:
            fail(
                ("handshake_test: %s does not test the path gate for its own state. Its " +
                 "condition is %s. Without that clause the state is planned on every push " +
                 "and pull request, which is the whole of what the gate removes.") %
                (id, job.if_condition),
            )

        # The nightly drift check and a manual dispatch plan states nobody touched — that
        # is what they are for — so the gate must not reach them. A condition that lost
        # this clause would leave the nightly run planning nothing and reporting drift on
        # nothing, which reads exactly like a stack that has stopped drifting.
        if "github.event_name != 'push'" not in job.if_condition:
            fail(
                ("handshake_test: %s gates events other than push and pull request. Its " +
                 "condition is %s. The nightly drift check exists to plan states nobody " +
                 "touched, and a gated schedule would find drift in none of them.") %
                (id, job.if_condition),
            )

        # Positive and negative in one loop. The publisher reads nothing, so an upstream
        # clause on its plan would mean the clauses are sprayed onto every job rather than
        # derived from the handshake — which a test that only ever looked at the subscriber
        # would pass.
        for candidate in [pub]:
            present = applied(candidate) in job.if_condition
            if present != (candidate in upstreams):
                fail(
                    ("handshake_test: %s %s an upstream clause for %s. Its condition is " +
                     "%s, and its upstreams are %s. That clause is what plans a state " +
                     "after the state it reads has moved, and it belongs to the " +
                     "handshake — on the jobs that have one, and on no others.") %
                    (
                        id,
                        "carries" if present else "is missing",
                        "apply_%s" % slug(candidate),
                        job.if_condition,
                        ["apply_%s" % slug(u) for u in upstreams],
                    ),
                )

    return {}
