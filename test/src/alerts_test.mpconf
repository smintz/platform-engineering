load("@grafana//grafana/alerts.pinc", "alerts")
load("@platform//platform/v1/platform.proto", "Component")
load("encoding/json.star", "json")

# What the golden files cannot see: that the ">= 0" NaN filter lands on the Prometheus burn
# stages and nowhere else. main() returns an empty dict, so this writes no output file; a
# tripped assertion is a failed build.

def _objective(datasource, burn):
    query = Component.Objective.Query(datasource = datasource, query = "q", min = 0.99)
    if burn:
        query.burn_query = "good[$__window] / valid[$__window]"
    else:
        query.threshold_alert = "ticket"
    return Component.Objective(name = datasource, query = query)

def _exprs(objective):
    component = Component(name = "probe", domain = "us-east-1")
    found = []
    for rule in alerts.rules(component, [objective], lambda kind: "uid"):
        for stage in rule.data[:2]:
            if stage.datasource_uid != "-100":
                model = json.decode(stage.model)
                found.append(model.get("expr") or model.get("rawSql"))
    return found

def _expect(label, exprs, wrapped):
    if not exprs:
        fail("%s: no query stages" % label)
    for expr in exprs:
        if expr.endswith(") >= 0") != wrapped:
            fail("%s: wrapped=%s expected, got %s" % (label, wrapped, expr))

def main():
    _expect("prometheus burn", _exprs(_objective("prometheus", True)), True)
    _expect("prometheus threshold", _exprs(_objective("prometheus", False)), False)
    _expect("postgres burn", _exprs(_objective("postgres", True)), False)
    return {}
