{
  "resource": {
    "kubernetes_deployment": {
      "redis": {
        "metadata": {
          "labels": {
            "app": "redis"
          },
          "name": "redis"
        },
        "spec": {
          "selector": {
            "match_labels": {
              "app": "redis"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "redis"
              }
            },
            "spec": {
              "container": [
                {
                  "image": "redis:7-alpine",
                  "name": "redis",
                  "port": [
                    {
                      "container_port": "6379"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "kubernetes_service": {
      "redis": {
        "metadata": {
          "labels": {
            "app": "redis"
          },
          "name": "redis"
        },
        "spec": {
          "selector": {
            "app": "redis"
          },
          "port": [
            {
              "port": "6379",
              "target_port": "6379"
            }
          ]
        }
      }
    }
  },
  "provider": {
    "kubernetes": [
      {
        "config_path": "~/.kube/config"
      }
    ]
  },
  "terraform": {
    "required_providers": {
      "kubernetes": {
        "source": "registry.terraform.io/hashicorp/kubernetes",
        "version": "3.2.1"
      }
    },
    "backend": {
      "s3": {
        "region": "us-east-1",
        "bucket": "platform-engineering-tfstate",
        "key": "us-east-1/redis.tfstate"
      }
    }
  }
}